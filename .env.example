# ============================================================
# TrialLens — environment variables
# Copy to .env.local (local) or set in Vercel. NEVER commit .env*. All values below are server-side only.
# NEVER prefix any server-side variable (secrets, keys, backend config) with NEXT_PUBLIC_.
# The ONE exception is NEXT_PUBLIC_UI_MODE (last section): intentionally public, non-secret, set at build time.
# In Vercel: set for Production + Preview; mark secrets as Sensitive.
# ============================================================

# --- Nebius Token Factory (SECRET) ---------------------------
NEBIUS_API_KEY=
# VERIFY exact base URL in the Token Factory docs (OpenAI-compatible endpoint)
NEBIUS_BASE_URL=
# VERIFY exact model IDs in the Token Factory catalog (Nemotron 3 Nano / Super / Ultra per Rules)
NEMOTRON_MODEL_FAST=
NEMOTRON_MODEL_MID=
# NEMOTRON_MODEL_DEEP is unused (Ultra escalation was cut).

# --- Supabase (SECRET: service role bypasses RLS) -------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (SECRET) -----------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- ClinicalTrials.gov (public, no key) ----------------------
CTGOV_API_BASE=https://clinicaltrials.gov/api/v2

# --- Pipeline tuning ------------------------------------------
# PARSER_VERSION is vestigial (the parser version is a code constant); leaving it unset is correct.
MAX_CANDIDATE_TRIALS=30
MAX_LLM_CALLS_PER_RUN=80
LLM_CONCURRENCY=6
# false = criteria cache is read-only (no Supabase writes, nothing kept in memory). Exact strings true/false only; anything else is an env error. Default true.
CRITERIA_CACHE_WRITES=true
# Candidate selection for live discovery (docs/selection-mode.md). Server-side only; NEVER a NEXT_PUBLIC_ variable. Default (unset/blank) = api-default = today's behavior.
# Only other valid value: relevance-v1-interventional (sort=@relevance, interventional studies only, fail-closed). Anything else is an env error (labelled replay).
CTGOV_SELECTION_MODE=api-default
TIER_UNKNOWN_THRESHOLD=3
MAX_INPUT_CHARS=2000   # one limit end to end (the Describe textarea allows the same 2000 characters)

# --- Abuse / cost protection ----------------------------------
RATE_LIMIT_RUNS_PER_IP_PER_HOUR=8
DAILY_RUN_BUDGET=150
REPLAY_FALLBACK_ENABLED=true

# --- Visitor input (privacy gate) -------------------------------
# samples (default) = only the prepared FICTIONAL texts are accepted by /api/extract and /api/run (visitor text never reaches the
# model provider). open = arbitrary text reaches the provider: keep OFF until the provider's zero-data-retention terms are verified
# IN WRITING and the privacy copy is approved. open additionally REQUIRES PROFILE_SIGNING_SECRET and RATE_LIMIT_IP_SALT.
VISITOR_INPUT_MODE=samples
# SECRET, 32+ characters (e.g. `openssl rand -base64 48`). Signs extract tokens; needed by /api/extract in every mode. Mark Sensitive.
PROFILE_SIGNING_SECRET=
# SECRET, 16+ characters. Salts the hashed IP rate-limit bucket. Mark Sensitive. Required when VISITOR_INPUT_MODE=open.
RATE_LIMIT_IP_SALT=
RATE_LIMIT_EXTRACT_PER_IP_PER_HOUR=12
DAILY_EXTRACT_BUDGET=300
MAX_CONCURRENT_RUNS=3

# --- Optional (stretch) ---------------------------------------
# TAVILY_API_KEY=            # only if adding glossary grounding; must be a real runtime call for the Tavily bonus

# --- Misc ------------------------------------------------------
# LOG_LEVEL is unused.

# --- UI mode (NON-secret, baked in at build time) ---------------
# live = the live pipeline UI (the release baseline; set it for the Production build, then redeploy: it is inlined at build).
# unset / fixed = the fixed fictional demo. Real visitor input still requires VISITOR_INPUT_MODE=open, which stays gated.
NEXT_PUBLIC_UI_MODE=live
