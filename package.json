    "spike:structured": "NODE_USE_ENV_PROXY=1 tsx eval/spike/02-structured.ts",
    "spike:coverage": "NODE_USE_ENV_PROXY=1 tsx eval/spike/04-coverage.ts",
    "spike:budget": "tsx eval/spike/06-call-budget.ts",
